{
  "name": "routine-tracker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "PWA offline-first de seguimiento de rutinas diarias. Sin dependencias, sin backend.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "serve": "npx --yes http-server . -p 8080 -c-1",
    "icons": "node scripts/generate-icons.mjs",
    "check:precache": "node scripts/check-precache.mjs"
  }
}
